# 环境选择：local 使用仓库 data/；cloud 默认使用 /workspace/project03。
RAG_ENV=local
RAG_DATA_ROOT=

# 服务地址在接入真实服务前必须明确配置；本地可填回环地址或 Compose 服务名。
RAG_KAFKA_BOOTSTRAP_SERVERS=
RAG_REDIS_URL=
# 填 MinerU API 根地址，不带 /v1，例如 http://127.0.0.1:8000。
RAG_MINERU_BASE_URL=
RAG_EMBEDDING_BASE_URL=
RAG_CHAT_BASE_URL=
RAG_WEB_HOST=0.0.0.0
RAG_WEB_PORT=8000

# 模型与并发参数
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_CHAT_MODEL=Qwen/Qwen3-VL-4B-Instruct
RAG_KAFKA_TOPIC=rag.pdf.ingest
RAG_KAFKA_GROUP_ID=rag-pdf-workers
RAG_KAFKA_PARTITIONS=3
RAG_KAFKA_CONSUMERS=2
RAG_CHAT_MAX_CONCURRENCY=1
RAG_CHAT_QUEUE_CAPACITY=16
RAG_CHAT_STATUS_TTL_SECONDS=604800
RAG_CHAT_LOG_MAX_BYTES=10485760
RAG_CHAT_LOG_BACKUP_COUNT=5
RAG_MAX_CHAT_IMAGE_BYTES=10485760
RAG_MAX_PDF_BYTES=52428800
RAG_PROCESSING_MAX_ATTEMPTS=4
RAG_PROCESSING_RETRY_DELAYS=1,2,4
RAG_MINERU_TASK_TIMEOUT_SECONDS=1800
RAG_MINERU_POLL_INTERVAL_SECONDS=2
