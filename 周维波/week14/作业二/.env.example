# ===== 基础 =====
# 数据目录（上传文件、解析产物、SQLite、临时文件都在这里）
# DATA_DIR=./data
# API_HOST=127.0.0.1
# API_PORT=8000
# PUBLIC_BASE_URL=http://127.0.0.1:8000    # 用于改写答案里的图片绝对地址，部署到服务器时改成公网地址
# MAX_UPLOAD_MB=100
# MAX_FILES_PER_UPLOAD=20

# ===== Kafka =====
# KAFKA_BOOTSTRAP=127.0.0.1:9092
# TOPIC_PARSE_REQUEST=rag.parse.request
# TOPIC_PARSE_STATUS=rag.parse.status
# TOPIC_PARSE_DLQ=rag.parse.dlq
# WORKER_GROUP=rag-parse-workers
# KAFKA_PARTITIONS=3
# PARSE_MAX_ATTEMPTS=3
# RETRY_BACKOFF_SEC=3

# ===== 文档解析 =====
# PARSER_BACKEND=mineru            # mineru | pymupdf（pymupdf 为无 GPU 的兜底解析）
# MINERU_EXECUTABLE=mineru
# MINERU_BACKEND=pipeline          # pipeline | vlm-transformers | vlm-http-client
# MINERU_API_URL=http://127.0.0.1:30000
# MINERU_TIMEOUT_SEC=900
# MINERU_EXTRA_ARGS=
# CHUNK_SIZE=800

# ===== 向量化 =====
# EMBED_BACKEND=local              # local(bge+CLIP) | hash（零模型依赖，仅开发验证）
# TEXT_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# CLIP_MODEL=jinaai/jina-clip-v2
# TEXT_DIM=512
# CLIP_DIM=1024
# EMBED_DEVICE=cpu                 # cuda 有显卡时更快
# EMBED_BATCH_SIZE=8
# HF_ENDPOINT=https://hf-mirror.com

# ===== 向量库 =====
# VECTOR_STORE=sqlite              # sqlite | milvus（配置 MILVUS_URI 时默认 milvus）
# MILVUS_URI=https://in03-xxxx.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
# MILVUS_TOKEN=
# MILVUS_COLLECTION=rag_chunks

# ===== 检索 / 问答 =====
# TOP_K_TEXT=5
# TOP_K_IMAGE=3
# MAX_CONTEXT_CHARS=6000
# SEND_RETRIEVED_IMAGES=true       # 是否把检索到的图片作为 image_url 一起送 VLM
# MAX_IMAGES_TO_LLM=3
# LLM_BACKEND=openai               # openai（任何 OpenAI 兼容网关）| mock（不调用模型，直出检索结果）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=qwen-vl-max
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1500
