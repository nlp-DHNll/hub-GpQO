{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ESG Action Tracker",
  "type": "object",
  "required": [
    "schema_version",
    "report_month",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report_month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "action"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low",
              null
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "horizon": {
            "enum": [
              "short",
              "medium",
              "long",
              "unknown",
              null
            ]
          },
          "deliverable": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "not_started",
              "in_progress",
              "blocked",
              "completed",
              "overdue",
              "cancelled",
              null
            ]
          },
          "source_trigger": {
            "type": [
              "string",
              "null"
            ]
          },
          "related_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  }
}
