{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ESG Intelligence Dataset",
  "type": "object",
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "item_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "company": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "event_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "publish_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "industry": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "analysis": {
            "type": [
              "string",
              "null"
            ]
          },
          "relevance": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown",
              null
            ]
          },
          "relevance_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_type": {
            "enum": [
              "primary",
              "secondary",
              "aggregator",
              "user_provided",
              "unknown",
              null
            ]
          },
          "verification_status": {
            "enum": [
              "verified",
              "partially_verified",
              "unverified",
              "pending",
              "not_applicable",
              null
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  }
}
