                },
                "table_caption": [],
                "table_footnote": [],
                "html": "<table><tr><td>Conversation state</td><td>https://developers.openai.com/api/docs/guides/conversation-state</td></tr><tr><td>Background mode</td><td>https://developers.openai.com/api/docs/guides/background</td></tr><tr><td>Streaming</td><td>https://developers.openai.com/api/docs/guides/streaming-responses</td></tr><tr><td>WebScoket mode</td><td>https://developers.openai.com/api/docs/guides/websocket-mode</td></tr><tr><td>Webhooks</td><td>https://developers.openai.com/api/docs/guides/webhooks</td></tr><tr><td>File inputs</td><td>https://developers.openai.com/api/docs/guides/file-inputs</td></tr><tr><td>Context management</td><td>https://developers.openai.com/api/docs/guides/compactionhttps://developers.openai.com/api/docs/guides/token-countinghttps://developers.openai.com/api/docs/guides/prompt-caching</td></tr><tr><td>Prompting</td><td>https://developers.openai.com/api/docs/guides/promptinghttps://developers.openai.com/api/docs/guides/prompt-engineeringhttps://developers.openai.com/api/docs/guides/citation-formatting</td></tr><tr><td>Reasoning</td><td>https://developers.openai.com/api/docs/guides/reasoninghttps://developers.openai.com/api/docs/guides/reasoning-best-practices</td></tr></table>",
