# ==========================================================================
# 本地开发环境变量样例
#
#   cp deploy/.env.example backend/.env
#
# 这份是**本地开发**取值（Mock 模式 + 指向宿主机上的 compose 容器）。
# 生产（云端）的取值见 docs/07-部署指南.md §6。
# ==========================================================================

# ---------- 通用 ----------
MOCK_MODE=false
# 可单独覆盖总开关：例如「真 MinerU + 假 LLM」混合调试
# MOCK_MINERU=false
# MOCK_LLM=true
DATA_DIR=./data
LOG_LEVEL=INFO

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8080
MAX_UPLOAD_MB=100
MAX_FILES_PER_UPLOAD=20

# ---------- Kafka（宿主机直连 compose 暴露的 127.0.0.1:9092）----------
# 必须写 127.0.0.1 而不是 localhost：Windows 上 localhost 先解析成 IPv6 ::1，
# 端口映射只监听 IPv4，kafka-python 会卡在 "Unable to bootstrap"
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_UPLOAD=pdf.upload
KAFKA_TOPIC_STATUS=pdf.parse.status
KAFKA_TOPIC_DLQ=pdf.upload.dlq
KAFKA_CONSUMER_GROUP=pdf-parser
KAFKA_STATUS_CONSUMER_GROUP=status-bus
KAFKA_PARTITIONS=2
KAFKA_MAX_ATTEMPTS=3
# 必须显式指定 broker 版本，kafka-python 自动探测在 KRaft 单节点上会超时
KAFKA_API_VERSION=3.9.0

# ---------- Elasticsearch ----------
ES_URL=http://localhost:9200
ES_INDEX_DOCUMENTS=mmrag-documents
ES_INDEX_CHUNKS=mmrag-chunks
ES_INDEX_IMAGES=mmrag-images
ES_INDEX_SESSIONS=mmrag-sessions
ES_VECTOR_DIM=1024

# ---------- vLLM（MOCK_MODE=true 时不访问）----------
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3-vl
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_IMAGE_MAX_PIXELS=1003520

# ---------- Embedding ----------
# mock：确定性伪向量，离线开发用
# openai：任意 OpenAI 兼容的文本 embedding 服务（图片路降级为 caption 文本）
# local：本地 Qwen3-VL-Embedding-0.6B（真实图文统一空间，需 pip install -e ".[local]"）
EMBEDDING_BACKEND=mock
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_LOCAL_MODEL_PATH=/models/Qwen3-VL-Embedding-0.6B

# ---------- MinerU ----------
# TODO: 申请 token 后填入 https://mineru.net/apiManage/token
MINERU_BASE_URL=https://mineru.net/api
MINERU_API_KEY=sk-oFAegeYKV1Fdda07RXOFjo5RNocPvJ4ANXFzhaI5MS8YKWpD
MINERU_SUBMIT_MODE=upload
MINERU_TASK_PATH=/v4/extract/task
MINERU_RESULT_PATH=/v4/extract/task/{task_id}
MINERU_FILE_URLS_PATH=/v4/file-urls/batch
MINERU_BATCH_RESULT_PATH=/v4/extract-results/batch/{batch_id}
MINERU_MODEL_VERSION=vlm
MINERU_IS_OCR=false
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_LANGUAGE=ch
# 必须为 true，否则 15 分钟内重解析会拿到旧结果
MINERU_NO_CACHE=true
MINERU_POLL_INTERVAL=3
MINERU_POLL_TIMEOUT=1800
# 按需截取页数可省 MinerU 免费额度（1000 页/天）；留空=全量
MINERU_PAGE_RANGES=
PARSE_TIMEOUT_SECONDS=1800

# ---------- 检索 ----------
TOP_K_BM25=20
TOP_K_VECTOR=20
TOP_K_FINAL=8
RRF_RANK_CONSTANT=60
MAX_DOC_IMAGES=4
MAX_USER_IMAGES=4
IMAGE_MAX_EDGE=1600
IMAGE_JPEG_QUALITY=85

# ---------- 切块 ----------
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
CHUNK_MIN_TOKENS=30
CHUNK_MAX_TOKENS=900

# ---------- 会话 ----------
CHAT_HISTORY_TURNS=3
