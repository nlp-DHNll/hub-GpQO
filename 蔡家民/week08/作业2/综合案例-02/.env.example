# 复制为 .env，务必填入全新的密钥；不要复用曾出现在文档中的密钥。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/
MODEL_NAME=deepseek-chat
BOCHA_API_KEY=
BOCHA_SEARCH_COUNT=6

# 运行 `PASSWORD=你的密码 python -m backend.auth` 生成。
SHARED_PASSWORD_HASH=
SESSION_SECRET=请替换为至少32位随机字符串
COOKIE_SECURE=0

# 本地单进程默认 SQLite；Docker Compose 会覆盖为 PostgreSQL。
DATABASE_URL=sqlite:///./backend/data/research.db
REDIS_URL=redis://localhost:6379/0
USE_CELERY=0
FRONTEND_ORIGIN=http://localhost:3000
LLM_RETRIES=3
FETCH_PAGE_TIMEOUT=12
MAX_PAGE_CHARS=12000
