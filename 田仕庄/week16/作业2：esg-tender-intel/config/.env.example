# 复制为 config/.env 后填写。此文件不要提交到版本库。
#
# macOS / Linux :  cp config/.env.example config/.env
# Windows CMD   :  copy config\.env.example config\.env
# PowerShell    :  Copy-Item config\.env.example config\.env

# 博查 Web Search：https://open.bochaai.com 注册后获取，形如 sk-xxxxxxxx
BOCHA_API_KEY=

# 覆盖 scope.yaml 里的 endpoint（一般不用改）
# BOCHA_ENDPOINT=https://api.bochaai.com/v1/web-search

# ---------------------------------------------------------------- 推送（可选）
# 群机器人：企业微信 / 飞书 / 钉钉都支持，脚本按域名自动识别 payload 形状。
# 地址里带 token，只写在这里或环境变量里，不要贴进命令行。
# NOTIFY_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 邮件推送（--notify email 时才需要）。465 走 SSL，587 走 STARTTLS。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=reports@example.com
# SMTP_PASSWORD=
# SMTP_FROM=reports@example.com
# SMTP_TO=a@example.com,b@example.com
