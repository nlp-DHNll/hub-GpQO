# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交

# ---- 大模型（OpenAI 兼容接口，summarize.py 逐篇提炼用）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat

# ---- 搜索源（search.py 使用；按 BOCHA > TAVILY > SERPER 顺序自动选择）----
# 都未配置时，search.py 读取 agent 用内置搜索导出的结果文件
BOCHA_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
