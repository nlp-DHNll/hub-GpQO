# ===== 大模型服务配置 =====
# 阿里云百炼（DashScope）OpenAI 兼容模式
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek 官方（如需启用 ds flash 4.1，请填写）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 应用配置 =====
# 默认模型（在网页下拉框里可切换）
DEFAULT_MODEL=qwen3.8-omni-flash
# 单次识别超时（秒）
REQUEST_TIMEOUT=60
# 同一张图 + 同一模型的结果缓存
ENABLE_CACHE=1
# 落地保存上传的原图（便于复现），0 关闭
SAVE_UPLOAD=1
# 监听地址与端口
HOST=0.0.0.0
PORT=8000

# 关闭思考链：1=关（快，推荐） 0=保留推理（慢但复杂场景略稳）
DISABLE_THINKING=1
