# ===== 大模型服务（OpenAI 兼容协议）=====
# 默认走 DeepSeek；换成阿里云百炼 / OpenAI 时只改 base_url + model。
#DEEPSEEK_API_KEY=
#SQL_AGENT_BASE_URL=https://api.deepseek.com

# ---- 阿里云百炼（DashScope）示例 ----
 DASHSCOPE_API_KEY=sk-ws-H.YRLLHIP.dBp2.MEQCIH6vpPa5R_IESTEsttP_jBQr1WNzD8I2j9v0EFn3F_OqAiB99EVuoml_edou4rpLoUlAV00b47fmkaE4Gd6zHoYcEg
 SQL_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
 SQL_AGENT_MODEL=qwen3.8-27b
 SQL_AGENT_SUMMARY_MODEL=qwen3.8-27b

# ---- OpenAI 示例 ----
# OPENAI_API_KEY=
# SQL_AGENT_BASE_URL=https://api.openai.com/v1
# SQL_AGENT_MODEL=gpt-4o-mini
# SQL_AGENT_SUMMARY_MODEL=gpt-4o-mini

# ===== 模型 =====
# 选表 / 生成 / 改写用强模型，汇总用便宜的
SQL_AGENT_MODEL=qwen3.8-27b
SQL_AGENT_SUMMARY_MODEL=qwen3.8-27b

# 结构化输出方式：function_calling（默认）/ json_mode / json_schema
SQL_AGENT_STRUCTURED_METHOD=function_calling
SQL_AGENT_LLM_TIMEOUT=90
SQL_AGENT_LLM_RETRIES=2

# ===== 编排与安全 =====
# 校验失败 + 执行失败共享的修复预算
SQL_AGENT_MAX_REPAIR_ATTEMPTS=3
# 执行层返回行数上限
SQL_AGENT_MAX_ROWS=200
# 进入汇总 prompt 的行数上限
SQL_AGENT_MAX_SUMMARY_ROWS=50
# 单元格长度上限
SQL_AGENT_MAX_CELL_CHARS=2000
# 单条 SQL 执行超时（秒）
SQL_AGENT_QUERY_TIMEOUT=5
# LangGraph 最大步数（防止图跑飞）
SQL_AGENT_RECURSION_LIMIT=50

# ===== 数据库 =====
# 留空则用项目内 data/chinook.db
# SQL_AGENT_DB=data/chinook.db

# ===== 日志 =====
SQL_AGENT_LOG_LEVEL=INFO

# ===== 可选：LangSmith 追踪 =====
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=sql-agent-langgraph
