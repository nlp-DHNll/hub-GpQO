# 复制本文件内容追加到 邓帅/.env（作业代码向上查找自动命中）
# ===== LLM（百炼 OpenAI 兼容，已有则无需重复）=====
API_KEY=sk-xxx
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BASE_MODEL=qwen3.8-max
# 视觉模型（图问用，OpenAI 兼容 image_url 格式，已实测可用）
VL_MODEL=qwen3-vl-plus

# ===== Zilliz Cloud Serverless =====
# 控制面 API（api.cloud.zilliz.com.cn）用 ZILLIZ_TOKEN；
# 数据面（pymilvus）用 USER_NAME + PASSWORD —— 两者凭据不同！
ZILLIZ_URI=https://in03-xxxx.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
ZILLIZ_USER_NAME=db_xxx
ZILLIZ_PASSWORD=xxx
ZILLIZ_TOKEN=xxx

# ===== Kafka =====
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=rag-data

# ===== MinerU =====
# vlm-mlx-engine（Apple Silicon MLX 加速）| pipeline（CPU 兜底）
MINERU_BACKEND=vlm-mlx-engine

# ===== 模型下载 =====
HF_ENDPOINT=https://hf-mirror.com
